# runtime artifacts
iceberg_output/
_staging/
control_state.json
exports/

# GUI runtime artifacts
run_logs/
gui/state/
.dagster_home/

# dlt working dirs
.dlt/pipelines/
*.duckdb

# python
__pycache__/
*.pyc
.venv/
venv/

# secrets / per-host config stay local (edited by the GUI on each host)
.dlt/secrets.toml
.dlt/config.toml
# tables.json plus the scratch/backup copies kept beside it (tables.json.temp,
# tables.json.<stamp>.bak) -- all per-host, none of it belongs in the repo.
tables.json*

# GUI server console logs
gui-server.log
gui-server.err.log

# pytest local basetemp
.pytest_tmp/

# dg CLI cache/telemetry
.dg/

# The dbt project is per-host working state, like tables.json and .dlt/: models,
# tests and macros are authored through the GUI's Models page, profiles.yml is
# generated from app config, and target/ logs/ dbt_packages/ are build output.
#
# dbt_project.yml is the exception and stays tracked: dbt refuses to start
# without it and, unlike profiles.yml, nothing generates it -- ignoring it would
# leave a fresh clone unable to run dbt at all. The pattern has to be `dbt/*`
# rather than `dbt/`, because git does not descend into an excluded directory
# and a negation inside one would never be reached.
dbt/*
!dbt/dbt_project.yml
