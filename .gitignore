.pytest_tmp/

# dg CLI cache/telemetry
.dg/

# dbt project: track the source, ignore what is generated or per-host.
# profiles.yml is generated from app config (and holds the ClickHouse password),
# and target/ logs/ dbt_packages/ .user.yml are build output or local state.
#
# dbt_project.yml stays tracked: dbt refuses to start without it and, unlike
# profiles.yml, nothing generates it -- ignoring it would leave a fresh clone
# unable to run dbt at all.
#
# models/, macros/ and tests/ ARE tracked. Although they are authored through
# the GUI's Models page, they are not regenerable: the per-layer schema files
# carry the model documentation and data tests, and the iceberg_source macro
# plus the lake sources file are what give the lineage graph its edges. Losing
# them loses the work, so they belong in version control like any other code.
#
# The pattern has to be `dbt/*` rather than `dbt/`, because git does not descend
# into an excluded directory and a negation inside one would never be reached.
dbt/*
!dbt/dbt_project.yml
!dbt/models/
!dbt/macros/
!dbt/tests/
# Atomic-write temp files from the GUI editors (write to .tmp, then rename).
dbt/**/*.tmp
